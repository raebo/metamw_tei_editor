# Required. Exposed to the client bundle (see PUBLIC_ENV_ALLOWLIST in webpack.config.js).
REACT_APP_API_URL=https://backend.metamw.local:3000

# Optional. Exposed to the client bundle. Enables extra debug output when set to "true".
#REACT_DEBUG_MODE=true

# NODE_ENV is intentionally not set here - webpack derives it from --mode instead. Setting it in
# .env caused a "Conflicting values for 'process.env.NODE_ENV'" build warning and could silently
# ship a dev-mode React build in production.
